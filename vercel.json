{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)analisis'",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
